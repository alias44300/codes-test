+func _apply_custom_art_overrides() -> void:
+    var dead_ids: Array[String] = []
+    for key: Variant in custom_art_paths.keys():
+        var cid: String = str(key)
+        var path: String = str(custom_art_paths.get(cid, ""))
+        if path == "" or not FileAccess.file_exists(path):
+            dead_ids.append(cid)
+    for cid: String in dead_ids:
+        custom_art_paths.erase(cid)
+
+    for d: Dictionary in roster:
+        var cid: String = str(d.get("id", ""))
+        if custom_art_paths.has(cid):
+            d["art"] = str(custom_art_paths[cid])
+            d["full_art"] = true
+        else:
+            var bundled: String = str(bundled_art_paths.get(cid, ""))
+            d["art"] = bundled
+            if bundled == "":
+                d["full_art"] = false
+
+func _show_import() -> void:
+    current_screen = "import"
+    var pages: int = maxi(1, int(ceil(float(roster.size()) / float(IMPORT_PAGE_SIZE))))
+    import_page = clampi(import_page, 0, pages - 1)
+    _base_screen("AJOUTER MES CARTES", "1. Choisis une case HOR-XXX   2. Choisir une image   3. Elle est enregistrée dans le jeu.", "import")
+
+    var holder: Control = Control.new()
+    holder.position = Vector2(28, 148)
+    holder.size = Vector2(size.x - 56, size.y - 310)
+    screen_layer.add_child(holder)
+
+    var grid: GridContainer = GridContainer.new()
+    grid.columns = 6
+    grid.position = Vector2(0, 0)
+    grid.size = holder.size
+    grid.add_theme_constant_override("h_separation", 16)
+    grid.add_theme_constant_override("v_separation", 12)
+    holder.add_child(grid)
+
+    var start: int = import_page * IMPORT_PAGE_SIZE
+    var finish: int = mini(start + IMPORT_PAGE_SIZE, roster.size())
+    for i: int in range(start, finish):
+        var d: Dictionary = roster[i]
+        var c: CardWidget = CardWidgetScript.new()
+        c.setup(d, Vector2(112, 168), true, true)
+        c.set_motion_enabled(false)
+        c.pressed_card.connect(_on_import_slot_pressed)
+        c.set_selected(str(d.get("id", "")) == import_target_id)
+        grid.add_child(c)
+
+    var status: Label = Label.new()
+    status.position = Vector2(28, size.y - 220)
+    status.size = Vector2(size.x - 56, 28)
+    status.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+    status.add_theme_font_size_override("font_size", 14)
+    status.add_theme_color_override("font_color", Color("d8ced9"))
+    if import_target_id == "":
+        status.text = "Sélectionne d'abord la carte que tu veux illustrer."
+    else:
+        var dsel: Dictionary = _get_card(import_target_id)
+        var suffix: String = " · IMAGE PERSO ACTIVE" if custom_art_paths.has(import_target_id) else ""
+        status.text = "%s · %s%s" % [import_target_id, str(dsel.get("name", "CARTE")).to_upper(), suffix]
+    screen_layer.add_child(status)
+
+    var choose: Button = Button.new()
+    choose.position = Vector2(size.x * 0.5 - 270, size.y - 184)
+    choose.size = Vector2(350, 50)
+    choose.text = "CHOISIR UNE IMAGE"
+    choose.add_theme_font_size_override("font_size", 15)
+    choose.disabled = import_target_id == ""
+    choose.pressed.connect(_open_import_picker)
+    screen_layer.add_child(choose)
+
+    var remove: Button = Button.new()
+    remove.position = Vector2(size.x * 0.5 + 95, size.y - 184)
+    remove.size = Vector2(230, 50)
+    remove.text = "RETIRER L'IMAGE PERSO"
+    remove.add_theme_font_size_override("font_size", 12)
+    remove.disabled = import_target_id == "" or not custom_art_paths.has(import_target_id)
+    remove.pressed.connect(_remove_custom_art)
+    screen_layer.add_child(remove)
+
+    _build_import_pager(import_page, pages)
+
+func _on_import_slot_pressed(card: CardWidget) -> void:
+    import_target_id = str(card.data.get("id", ""))
+    if vibration_enabled:
+        Input.vibrate_handheld(12)
+    _show_import()
+
+func _build_import_pager(page: int, pages: int) -> void:
+    var y: float = size.y - 126.0
+    var label: Label = Label.new()
+    label.position = Vector2(size.x * 0.5 - 120, y)
+    label.size = Vector2(240, 32)
+    label.text = "‹   %d / %d   ›" % [page + 1, pages]
+    label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+    label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+    label.add_theme_font_size_override("font_size", 15)
+    label.add_theme_color_override("font_color", Color("c9bfcd"))
+    screen_layer.add_child(label)
+
+    var prev: Button = Button.new()
+    prev.position = Vector2(size.x * 0.5 - 210, y - 4)
+    prev.size = Vector2(70, 40)
+    prev.text = "‹"
+    prev.add_theme_font_size_override("font_size", 24)
+    prev.disabled = page <= 0
+    prev.pressed.connect(_change_import_page.bind(-1))
+    screen_layer.add_child(prev)
+
+    var next: Button = Button.new()
+    next.position = Vector2(size.x * 0.5 + 140, y - 4)
+    next.size = Vector2(70, 40)
+    next.text = "›"
+    next.add_theme_font_size_override("font_size", 24)
+    next.disabled = page >= pages - 1
+    next.pressed.connect(_change_import_page.bind(1))
+    screen_layer.add_child(next)
+
+func _change_import_page(delta: int) -> void:
+    var pages: int = maxi(1, int(ceil(float(roster.size()) / float(IMPORT_PAGE_SIZE))))
+    import_page = clampi(import_page + delta, 0, pages - 1)
+    _show_import()
+
+func _open_import_picker() -> void:
+    if import_target_id == "":
+        _flash_message("Choisis d'abord une case HOR-XXX.")
+        return
+    var filters: PackedStringArray = PackedStringArray(["*.png,*.jpg,*.jpeg,*.webp;Images;image/png,image/jpeg,image/webp"])
+    var err: Error = DisplayServer.file_dialog_show(
+        "Choisir une image de carte",
+        "",
+        "",
+        false,
+        DisplayServer.FILE_DIALOG_MODE_OPEN_FILE,
+        filters,
+        _on_import_file_selected
+    )
+    if err != OK:
+        _flash_message("Le sélecteur Android n'est pas disponible sur cet appareil.")
+
+func _on_import_file_selected(status: bool, selected_paths: PackedStringArray, _selected_filter_index: int) -> void:
+    if not status or selected_paths.is_empty():
+        return
+    _import_image_for_target(selected_paths[0])
+
+func _decode_image_bytes(bytes: PackedByteArray) -> Image:
+    var img: Image = Image.new()
+    var err: Error = img.load_png_from_buffer(bytes)
+    if err != OK:
+        err = img.load_jpg_from_buffer(bytes)
+    if err != OK:
+        err = img.load_webp_from_buffer(bytes)
+    if err != OK:
+        return null
+    return img
+
+func _import_image_for_target(source_path: String) -> void:
+    if import_target_id == "":
+        return
+    var src: FileAccess = FileAccess.open(source_path, FileAccess.READ)
+    if src == null:
+        _flash_message("Impossible de lire cette image.")
+        return
+    var bytes: PackedByteArray = src.get_buffer(src.get_length())
+    src.close()
+    var img: Image = _decode_image_bytes(bytes)
+    if img == null or img.is_empty():
+        _flash_message("Format non reconnu. Utilise PNG, JPG ou WEBP.")
+        return
+    if img.get_width() < 200 or img.get_height() < 300:
+        _flash_message("Image trop petite. Minimum conseillé : 200 × 300 px.")
+        return
+
+    var dir_path: String = ProjectSettings.globalize_path("user://custom_cards")
+    var mk: Error = DirAccess.make_dir_recursive_absolute(dir_path)
+    if mk != OK and mk != ERR_ALREADY_EXISTS:
+        _flash_message("Impossible de créer le dossier des cartes.")
+        return
+    var safe_id: String = import_target_id.to_lower().replace("-", "_")
+    var dest: String = "user://custom_cards/%s.png" % safe_id
+    var save_err: Error = img.save_png(dest)
+    if save_err != OK:
+        _flash_message("Impossible d'enregistrer l'image dans le jeu.")
+        return
+
+    custom_art_paths[import_target_id] = dest
+    owned_counts[import_target_id] = maxi(1, int(owned_counts.get(import_target_id, 0)))
+    _apply_custom_art_overrides()
+    _save()
+    if vibration_enabled:
+        Input.vibrate_handheld(45)
+    _show_import()
+    _flash_message("%s ajoutée au jeu." % import_target_id)
+
+func _remove_custom_art() -> void:
+    if import_target_id == "" or not custom_art_paths.has(import_target_id):
+        return
+    var path: String = str(custom_art_paths.get(import_target_id, ""))
+    if path != "" and FileAccess.file_exists(path):
+        DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
+    custom_art_paths.erase(import_target_id)
+    _apply_custom_art_overrides()
+    _save()
+    _show_import()
+    _flash_message("Illustration personnelle retirée pour %s." % import_target_id)
+
 func _show_collection() -> void:
     current_screen = "collection"
     var pages: int = maxi(1, int(ceil(float(roster.size()) / float(COLLECTION_PAGE_SIZE))))
